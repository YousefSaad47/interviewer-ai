# Application
ATS_APP_NAME="ATS Resume Builder"
ATS_ENVIRONMENT=development
ATS_LOG_LEVEL=INFO
ATS_INTERNAL_SERVICE_KEY=development-secret

# AI provider
ATS_AI_PROVIDER=gemini
ATS_GEMINI_API_KEY=
ATS_GEMINI_MODEL=gemini-2.5-flash
ATS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ATS_AI_TIMEOUT_SECONDS=30
ATS_AI_RETRY_LIMIT=2

# Prompting and ATS rules
ATS_PROMPT_VERSION=v1
ATS_ATS_RULES_VERSION=v1

# PDF compilation
ATS_COMPILER_PATH=xelatex
ATS_COMPILER_TIMEOUT_SECONDS=60
ATS_TEMPORARY_DIRECTORY=/tmp/resume-generation
