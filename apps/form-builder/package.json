{
  "name": "form-builder",
  "private": true,
  "scripts": {
    "dev": "uv run uvicorn main:app --app-dir src --reload --host 0.0.0.0 --port 8001",
    "start": "uv run uvicorn main:app --app-dir src --host 0.0.0.0 --port 8001",
    "lint": "uv run ruff check .",
    "lint:fix": "uv run ruff check --fix .",
    "format": "uv run ruff format .",
    "format:check": "uv run ruff format --check .",
    "type:check": "uv run ty check",
    "test": "uv run pytest"
  }
}
