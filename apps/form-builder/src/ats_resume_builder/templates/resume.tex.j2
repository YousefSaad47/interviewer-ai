\documentclass[10pt, letterpaper]{article}
\usepackage[
    top=1.4cm,
    bottom=1.4cm,
    left=1.8cm,
    right=1.8cm,
]{geometry}
\usepackage{fontspec}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}
\usepackage{needspace}

\setmainfont{Latin Modern Roman}
\pagestyle{empty}
\setcounter{secnumdepth}{0}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\raggedright
\pagenumbering{gobble}

\hypersetup{
    pdftitle={ {{ metadata_title }} },
    pdfauthor={ {{ metadata_author }} },
    pdfcreator={ATS Resume Builder}
}

\titleformat{\section}{\needspace{4\baselineskip}\bfseries\large}{}{0pt}{}[\vspace{1pt}\titlerule]
\titlespacing{\section}{0pt}{0.22cm}{0.12cm}

\newenvironment{highlights}{
    \begin{itemize}[
        topsep=0.03cm,
        parsep=0.03cm,
        partopsep=0pt,
        itemsep=0pt,
        leftmargin=14pt
    ]
}{
    \end{itemize}
}

\begin{document}

{\centering
    {\LARGE\textbf{ {{ personal.full_name }} }}\\[4pt]
    {% if personal.headline %}{{ personal.headline }}\\[4pt]{% endif %}
    {% for item in contact_items %}
        {% if item.url %}\href{ {{- item.url -}} }{ {{- item.text -}} }{% else %}{{ item.text }}{% endif %}{% if not loop.last %}\quad | \quad{% endif %}
    {% endfor %}
    \par
}

\vspace{0.18cm}

{% if resume.professional_summary %}\section{Professional Summary}
{{ resume.professional_summary }}
{% endif %}

{% if resume.experience %}\section{Experience}
{% for item in resume.experience %}
\textbf{ {{ item.title }} }\if\relax\detokenize{ {{ item.company }}{% if item.location %} -- {{ item.location }}{% endif %} }\relax\else, {{ item.company }}{% if item.location %} -- {{ item.location }}{% endif %}\fi\hfill {{ item.date_range }}\\
\begin{highlights}
{% for bullet in item.highlights %}\item {{ bullet }}
{% endfor %}\end{highlights}
\vspace{0.06cm}
{% endfor %}
{% endif %}

{% if resume.education %}\section{Education}
{% for item in resume.education %}
\textbf{ {{ item.degree }}{% if item.field_of_study %} in {{ item.field_of_study }}{% endif %} }\if\relax\detokenize{ {{ item.institution }}{% if item.location %} -- {{ item.location }}{% endif %} }\relax\else, {{ item.institution }}{% if item.location %} -- {{ item.location }}{% endif %}\fi\hfill {% if item.date_range %}{{ item.date_range }}{% endif %}\\
{% if item.description %}{{ item.description }}\\{% endif %}
{% if item.highlights %}\begin{highlights}
{% for detail in item.highlights %}\item {{ detail }}
{% endfor %}\end{highlights}{% endif %}
\vspace{0.06cm}
{% endfor %}
{% endif %}

{% if resume.skills %}\section{Skills}
{% for skill in resume.skills %}
\textbf{ {{ skill.name }} }{% if skill.level %} ({{ skill.level }}){% endif %}{% if skill.keywords %}: {{ skill.keywords | join(", ") }}{% endif %}\\
{% endfor %}
{% endif %}

{% if resume.projects %}\section{Projects}
{% for project in resume.projects %}
\textbf{ {{ project.name }} }{% if project.technologies %}, {{ project.technologies | join(", ") }}{% endif %}\hfill {% if project.url %}\href{ {{- project.url -}} }{Link}{% endif %}\\
\begin{highlights}
\item {{ project.description }}
{% for bullet in project.highlights %}\item {{ bullet }}
{% endfor %}\end{highlights}
\vspace{0.06cm}
{% endfor %}
{% endif %}

{% if resume.certifications %}\section{Certifications}
{% for item in resume.certifications %}
\textbf{ {{ item.name }} }{% if item.issuer %}, {{ item.issuer }}{% endif %}\hfill {% if item.issued_on %}{{ item.issued_on }}{% endif %}\\
{% if item.url %}\href{ {{- item.url -}} }{Credential}\\{% endif %}
\vspace{0.04cm}
{% endfor %}
{% endif %}

{% if resume.languages %}\section{Languages}
{% for item in resume.languages %}
\textbf{ {{ item.name }} }{% if item.level %}: {{ item.level }}{% endif %}\\
{% endfor %}
{% endif %}

\end{document}
